    "_postman_id": "a656c068-13fa-47bf-b00a-d4b4910d8436",
    "name": "Telemetron External API (ext-v1) Customer Ticket API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "RESTful API for syncing customer, device, and ownership-mapping data into Telemetron so it can correlate device telemetry with customers for AI-powered hardware support. Faithfully modeled from the published Telemetron API reference at https://docs.telemetron.ai/api-reference — every path, parameter, and response field below is transcribed from the docs; no fields were invented.\n\nContact Support:\n Name: Telemetron Support\n Email: support@telemetron.ai",
