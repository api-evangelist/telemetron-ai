          "name": "Assign a device to one or more customers",
          "request": {
            "name": "Assign a device to one or more customers",
            "description": {
              "content": "Assigns a device to one or more customers, creating the mapping used for telemetry correlation. Auto-creates customers if they don't exist; supports multi-owner (shared/family) devices; optionally auto-creates the device (requires deviceType).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "deviceAssignment",
                "assignDeviceToOwners"
              ],
              "host": [
